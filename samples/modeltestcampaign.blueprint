  "locations": [
    {
      "name": "The Crossroads of Ashenveil",
      "description": "A desolate three-way fork of packed earth and gray ash. The South Road leads south to the High Gate of Ashenveil, the North Road leads north into the wilderness, and a narrow wagon trail winds east into the Blighted Reach."
    },
    {
      "name": "Ashenveil",
      "description": "A sprawling, soot-choked port city of rotting wood and dark granite. The air smells of coal smoke, stale sea water, and rotting fish. The High Gate leads north to the Crossroads, the harbor docks lie to the east, and the twisting maze of the Low Quarter spreads south."
    }
  ],

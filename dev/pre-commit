#!/bin/sh
# Traffic and Dragons — pre-commit gate: TODO.md table lint + the test.html suites headlessly.
# This is the TRACKED copy; git only executes it from .git/hooks/. After a fresh clone, reinstall:
#   cp dev/pre-commit .git/hooks/pre-commit
# Bypassing (git commit --no-verify) is for emergencies only — a red suite means a real regression.
node "$(git rev-parse --show-toplevel)/dev/lint-todo.js" --git-aware --staged || {
  echo "" >&2
  echo "Commit blocked: TODO.md integrity failed — table shape or moved-row bytes differ from HEAD (findings above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/tests-todo-hygiene.js" || {
  echo "" >&2
  echo "Commit blocked: TODO/session hygiene acceptance fixtures failed (details above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/check-shell-markers.js" || {
  echo "" >&2
  echo "Commit blocked: staged app-shell files require fresh APP_VERSION and CACHE markers (details above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/run-tests.js" || {
  echo "" >&2
  echo "Commit blocked: engine tests failed. Open test.html in a browser for the red/green view." >&2
  exit 1
}

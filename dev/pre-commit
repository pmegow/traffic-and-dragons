#!/bin/sh
# Traffic and Dragons — pre-commit gate: TODO.md table lint + the test.html suites headlessly.
# This is the TRACKED copy; git only executes it from .git/hooks/. After a fresh clone, reinstall:
#   cp dev/pre-commit .git/hooks/pre-commit
# Bypassing (git commit --no-verify) is for emergencies only — a red suite means a real regression.
node "$(git rev-parse --show-toplevel)/dev/check-hook-parity.js" || {
  echo "" >&2
  echo "Commit blocked: installed .git/hooks/pre-commit differs from the tracked dev/pre-commit gate. Reinstall it first." >&2
  exit 1
}
# Identity tripwire (2026-08-16): a leaked fixture 'git config user.*' once misattributed 39
# real commits to 'Forensics Fixture <forensics@example.invalid>'. Any fixture-looking identity
# blocks the commit until git config user.name/user.email are restored. #481 G6: the rule lives in
# dev/check-identity.js, which CI also runs over every pushed commit's author (--ci).
node "$(git rev-parse --show-toplevel)/dev/check-identity.js" || {
  echo "" >&2
  echo "Commit blocked: the git identity looks like a test fixture (details above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/lint-todo.js" --git-aware --staged --cap || {
  echo "" >&2
  echo "Commit blocked: TODO.md integrity failed — table shape or moved-row bytes differ from HEAD (findings above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/check-todo-columns.js" --staged || {
  echo "Commit blocked: TODO row columns do not match their table header (details above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/tests-todo-hygiene.js" || {
  echo "" >&2
  echo "Commit blocked: TODO/session hygiene acceptance fixtures failed (details above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/check-es5.js" || {
  echo "" >&2
  echo "Commit blocked: the game client must stay ES5 — no const/let, arrow function, template literal or class (findings above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/check-shell-markers.js" || {
  echo "" >&2
  echo "Commit blocked: staged app-shell files require fresh APP_VERSION and CACHE markers (details above)." >&2
  exit 1
}
node "$(git rev-parse --show-toplevel)/dev/run-tests.js" || {
  echo "" >&2
  echo "Commit blocked: engine tests failed. Open test.html in a browser for the red/green view." >&2
  exit 1
}
